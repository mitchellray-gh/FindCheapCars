DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autofind
REDIS_URL=redis://localhost:6379
API_PORT=3001
NODE_ENV=development

# Proxy settings (optional for scraping)
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# NHTSA API (free, no key needed)
# https://vpic.nhtsa.dot.gov/api/

# Vehicle Databases API (optional, for Carfax-like data)
VEHICLE_DATABASES_API_KEY=
