# ── Database (Turso / libSQL) ────────────────────────────
# Local dev: leave these blank to use a local SQLite file at ./data/autofind.db
# Production (Vercel): create a free Turso DB and set both.
#   1. npm i -g @tursodatabase/cli   (or: brew install tursodatabase/tap/turso)
#   2. turso db create autofind
#   3. turso db show autofind --url          -> TURSO_DATABASE_URL
#   4. turso db tokens create autofind       -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: override the local SQLite file path (ignored if TURSO_DATABASE_URL is set)
# DATABASE_PATH=./data/autofind.db

# ── Scraping (optional) ──────────────────────────────────
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# NHTSA API (free, no key needed): https://vpic.nhtsa.dot.gov/api/
VEHICLE_DATABASES_API_KEY=
